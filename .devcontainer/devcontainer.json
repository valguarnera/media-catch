{
  "name": "media-catch",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/pnpm:1": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/certs,target=/workspace/certs,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}